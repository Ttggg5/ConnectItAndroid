<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 螢幕鏡像:分享螢幕期間前景服務要多宣告 mediaProjection 類型(Android 14 起需要這個權限)。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 只有 API 28(Android 9)以下的裝置需要:寫入公用 Download 資料夾。API 29 起改用
         MediaStore.Downloads,不需要這個權限。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- 同一個 APK 手機、平板、Android TV 共用:兩個 feature 都設 required="false",
         裝置沒有觸控螢幕(TV)或沒有 leanback(手機/平板)都不會被 Play 商店擋掉安裝。 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".ConnectItApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConnectIt"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|keyboardHidden"
            android:resizeableActivity="true"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.ConnectIt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android TV 主畫面(Leanback launcher)找得到這個 App 的關鍵:少了這個
                 category,App 裝得上 TV 但不會出現在 TV 的頻道/App 列表裡。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 從其他 App(相簿、檔案管理員…)按「分享」→ ConnectIt,直接選裝置傳送。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ConnectItService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection" />

        <!-- 螢幕鏡像的遠端操控:只有分享螢幕、而且使用者勾選「允許對方操控」時才會用到,
             使用者必須自己到系統的無障礙設定開啟(見 screen/ScreenControlAccessibilityService.kt)。
             只有系統持有 BIND_ACCESSIBILITY_SERVICE 權限,其他 App 綁不到它。 -->
        <service
            android:name=".screen.ScreenControlAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
