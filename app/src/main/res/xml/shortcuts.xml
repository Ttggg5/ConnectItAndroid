<?xml version="1.0" encoding="utf-8"?>
<!-- 分享面板的 Direct Share(見 quicksend/ShareShortcuts.kt):最近傳過檔案的裝置會出現在分享面板最上排。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.connectit.android.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.connectit.android.category.SHARE_TO_DEVICE" />
    </share-target>
</shortcuts>
